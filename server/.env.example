# server/.env.example — modèle de configuration
#
# Copier en `server/.env` et remplir. Ce fichier-ci ne contient AUCUNE valeur
# réelle et peut être versionné ; `server/.env` ne doit jamais l'être.

# ══ Base ══════════════════════════════════════════════
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# ══ Base de données ═══════════════════════════════════
# PostgreSQL (Render). La connexion se fait en SSL — voir config/database.js.
DATABASE_URL=postgresql://user:password@host:5432/database

# ══ Authentification ══════════════════════════════════
# Deux secrets DISTINCTS : si un jeton d'accès fuite, il ne doit pas permettre
# de forger un jeton de rafraîchissement.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Compte administrateur créé par `npm run db:seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ══ Connexion Google ══════════════════════════════════
# Identifiant client OAuth 2.0 de type « Application Web », obtenu sur
# https://console.cloud.google.com/apis/credentials
#
# Si cette variable est absente, la connexion Google est simplement désactivée :
# le bouton ne s'affiche pas et le formulaire email/mot de passe continue de
# fonctionner normalement. Aucun risque à laisser vide.
#
# Le CLIENT SECRET n'est PAS nécessaire : le site utilise Google Identity
# Services côté navigateur, et le serveur se contente de vérifier la signature
# de l'ID token contre les clés publiques de Google.
#
# Origines JavaScript autorisées à déclarer dans la console Google :
#   http://localhost:5173
#   https://otaku-pulse.com
#   https://www.otaku-pulse.com
GOOGLE_CLIENT_ID=

# ══ Emails (Nodemailer) ═══════════════════════════════
# Sans MAIL_USER et MAIL_PASS, `createTransporter()` renvoie null et TOUS les
# emails sont ignorés silencieusement (un simple avertissement en console).
# Confirmations de commande, réinitialisations de mot de passe et notifications
# admin ne partent alors jamais.
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USER=contact@otaku-pulse.com
MAIL_PASS=

# ══ Coordonnées imprimées sur les factures ════════════
# Valeurs par défaut dans routes/adminInvoices.js ; ces variables permettent de
# les changer sans redéployer le code.
COMPANY_NAME=Otaku Pulse
COMPANY_TAGLINE=Vivez l'expérience Otaku · Cameroun
COMPANY_EMAIL=contact@otaku-pulse.com
COMPANY_PHONE=+237 6 75 71 27 39
COMPANY_SITE=otaku-pulse.com
COMPANY_ADDRESS=Yaoundé · Douala · Bafoussam

# Identifiants légaux — À RENSEIGNER dès l'enregistrement de la structure.
# Laissés vides, ils n'apparaissent pas sur la facture. Ne jamais y mettre un
# numéro inventé : une facture portant un identifiant fiscal faux est bien plus
# problématique qu'une facture qui n'en porte aucun.
COMPANY_RCCM=
COMPANY_NIU=

# Numéros Mobile Money affichés dans le bloc « Règlement » de la facture
COMPANY_MOMO_MTN=675 71 27 39
COMPANY_MOMO_ORANGE=690 82 37 42

# ══ Cloudinary (téléversement d'images) ═══════════════
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ══ Fapshi — PHASE 1, PAS ENCORE IMPLÉMENTÉE ══════════
# Voir docs/phase-1-paiements.md. Ne rien mettre en mode `live` sans validation
# explicite : les clés sandbox commencent par FAK_TEST_.
# FAPSHI_ENV=sandbox
# FAPSHI_API_USER=
# FAPSHI_API_KEY=
# FAPSHI_WEBHOOK_SECRET=
